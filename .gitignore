# Entorno y cachés
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Temporales de pruebas y simulador
.tmp/

# Secretos: NUNCA al repositorio
.env
.env.*
!.env.example
secrets/
*.key
*.token
