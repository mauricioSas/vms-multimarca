# VMS Multimarca — latido de la sede hacia el panel central (HTTP con token por sede).
[Unit]
Description=VMS Multimarca - latido de sede
Documentation=file:///opt/vms-multimarca/LEEME.md
After=network-online.target vms.service
Wants=network-online.target

[Service]
Type=simple
User=vms
Group=vms
WorkingDirectory=/opt/vms-multimarca
Environment=VMS_DATA_DIR=/var/lib/vms-multimarca
Environment=PYTHONUNBUFFERED=1
Environment=VMS_ENV_FILE=/etc/vms-multimarca/vms.env
ExecStart=/opt/vms-multimarca/.venv/bin/python -m central.agent
Restart=always
RestartSec=15
TimeoutStopSec=15
StateDirectory=vms-multimarca
StateDirectoryMode=0750
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
