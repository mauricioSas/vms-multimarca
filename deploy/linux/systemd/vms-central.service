# VMS Multimarca — panel central multi-sede (servidor central, puerto 8700).
[Unit]
Description=VMS Multimarca - panel central
Documentation=file:///opt/vms-multimarca/LEEME.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vms
Group=vms
WorkingDirectory=/opt/vms-multimarca
Environment=VMS_CENTRAL_DATA_DIR=/var/lib/vms-multimarca/central
Environment=PYTHONUNBUFFERED=1
Environment=VMS_ENV_FILE=/etc/vms-multimarca/vms.env
ExecStart=/opt/vms-multimarca/.venv/bin/python -m central
Restart=always
RestartSec=5
TimeoutStopSec=20
StateDirectory=vms-multimarca
StateDirectoryMode=0750
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0027

[Install]
WantedBy=multi-user.target
