# ============================================================================
# VMS Multimarca — variables de entorno (copia este archivo como .env)
# El .env real NUNCA se sube al repositorio ni se envía por correo.
# Se busca en: <instalación>/.env, <carpeta de datos>/.env y VMS_ENV_FILE.
# ============================================================================

# --- General -----------------------------------------------------------------
# Carpeta de datos (config, logs, grabaciones por defecto). Vacío = la del sistema:
#   Windows: C:\ProgramData\VMSMultimarca · Linux: ~/.local/share/vms-multimarca
VMS_DATA_DIR=
VMS_LOG_LEVEL=INFO
# Identificador de la sede (minúsculas, números y guiones; único entre todas las tiendas)
VMS_SITE_ID=site-local

# --- Backend web ---------------------------------------------------------------
VMS_HTTP_HOST=0.0.0.0
VMS_HTTP_PORT=8600
# HTTPS para la LAN de la tienda (recomendado si alguien abre la web desde otro PC que no sea por
# la VPN): crea el certificado con «python -m vms tls-cert --host <nombre> --ip <IP LAN>» y pon aquí
# sus rutas. Con certificado, la web va por https://<IP>:VMS_HTTPS_PORT y el HTTP sin cifrar queda
# SOLO en 127.0.0.1 (muros en kiosco, analítica y agente de este PC). Ver docs/RED.md.
VMS_HTTPS_PORT=8643
VMS_TLS_CERT_FILE=
VMS_TLS_KEY_FILE=
VMS_SESSION_HOURS=12
# Contraseña del primer administrador (usuario «admin»). Si se deja vacía, el primer
# arranque pide crearlo desde el propio PC (http://127.0.0.1:8600/setup).
VMS_ADMIN_INITIAL_PASSWORD=
# Token del lanzador de muros en modo kiosco (largo y aleatorio). Solo válido desde el propio PC.
VMS_KIOSK_TOKEN=
VMS_KIOSK_ALLOW_REMOTE=false
# Token interno analítica ↔ backend. Vacío = se genera en <datos>/secrets/internal.token
VMS_INTERNAL_TOKEN=

# --- Credenciales de cámaras y NVR -------------------------------------------
# auto: almacén del sistema si existe; si no, archivo cifrado. Valores: auto | keyring | file
VMS_CREDENTIAL_BACKEND=auto
# Clave Fernet del archivo cifrado (vacío = se genera en <datos>/secrets/secret.key)
VMS_SECRET_KEY=

# --- MediaMTX (motor de vídeo) -----------------------------------------------
# Ruta del ejecutable (vacío = <instalación>/bin/mediamtx[.exe])
VMS_MEDIAMTX_BIN=
VMS_MTX_RTSP_ADDRESS=127.0.0.1:8554
VMS_MTX_WEBRTC_ADDRESS=127.0.0.1:8889
# ICE de WebRTC (vídeo directo al navegador). Escribe «off» para desactivar uno (vacío = valor por defecto)
VMS_MTX_WEBRTC_ICE_UDP=:8189
VMS_MTX_WEBRTC_ICE_TCP=:8189
# IPs extra que anunciar en WebRTC (p. ej. la IP de la VPN), en JSON: ["100.64.0.12"]
VMS_MTX_WEBRTC_ADDITIONAL_HOSTS=[]
VMS_MTX_API_ADDRESS=127.0.0.1:9997
VMS_MTX_PLAYBACK_ADDRESS=127.0.0.1:9996
VMS_MTX_METRICS_ADDRESS=127.0.0.1:9998

# --- PostgreSQL (conteos, latidos, informes) ---------------------------------
# Cada tienda con SU rol (solo ve y escribe sus filas). En el servidor central:
#   python -m vms.db.site_roles create site-bcn-001 --dsn postgresql://postgres@localhost/vms
# que imprime la línea lista, p. ej.:
#   postgresql://vms_site_bcn_001:CONTRASEÑA@100.64.0.1:5432/vms?sslmode=require
VMS_PG_DSN=
VMS_HEARTBEAT_SECONDS=60

# --- Alertas e informe semanal ------------------------------------------------
VMS_TELEGRAM_BOT_TOKEN=
# Proveedor LLM configurable para redactar el informe semanal: anthropic | none
VMS_LLM_PROVIDER=anthropic
# Modelo del proveedor (obligatorio si se activa el informe)
VMS_LLM_MODEL=
VMS_LLM_API_KEY=

# --- Analítica (opcional; los valores por defecto sirven en una instalación normal) ---
# Carpeta de modelos exportados (vacío = <instalación>/models)
VMS_ANALYTICS_MODELS_DIR=
# Motor de inferencia: auto (OpenVINO → ONNX Runtime) | openvino | onnxruntime
VMS_ANALYTICS_INFERENCE_BACKEND=auto
# Hilos por modelo (0 = automático). Con varias cámaras en un mini PC conviene 2-4.
VMS_ANALYTICS_INFERENCE_THREADS=0
# Avisar también por Telegram cuando la cola se normaliza
VMS_ANALYTICS_NOTIFY_CLEAR=true
# Bot API de Telegram (solo si usas un servidor Bot API propio o un proxy)
VMS_ANALYTICS_TELEGRAM_API_BASE=
# URL del backend si no es http://127.0.0.1:<VMS_HTTP_PORT>
VMS_ANALYTICS_BACKEND_URL=

# --- Latido HTTP de la sede (servicio VMSHeartbeat / vms-heartbeat) -----------
# Alternativa al latido directo por VMS_PG_DSN: envía el estado al panel central con un token
# propio de la sede (se crea en la central: Administración → Tokens, o «python -m central token create»).
VMS_CENTRAL_URL=
VMS_SITE_TOKEN=
# Usuario OPERADOR del backend para incluir el estado de cada cámara (opcional)
VMS_AGENT_USERNAME=
VMS_AGENT_PASSWORD=
# Backend local (por defecto http://127.0.0.1:8600)
VMS_AGENT_BACKEND_URL=

# --- Panel central (solo en el servidor central: python -m central) -----------
# Base de datos del panel (vacío = VMS_PG_DSN)
VMS_CENTRAL_PG_DSN=
VMS_CENTRAL_HTTP_PORT=8700
# Crea el usuario «admin» del panel en el primer arranque (bórralo después)
VMS_CENTRAL_ADMIN_INITIAL_PASSWORD=
# true si el panel está detrás de HTTPS
VMS_CENTRAL_SECURE_COOKIES=false
