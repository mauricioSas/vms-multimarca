    {"path": ["services", "uninstall"], "switches": ["--purge"]},
    {"path": ["services", "start"], "values": ["--only"]},
    {"path": ["services", "stop"], "values": ["--only"]},
    {"path": ["services", "restart"], "values": ["--only"]},
    {"path": ["services", "status"]},
    {"path": ["firewall", "apply"], "values": ["--profiles", "--role"], "required": ["--profiles"]},
    {"path": ["firewall", "remove"]},
    {"path": ["acl", "apply"], "values": ["--role", "--recordings-dir"]},
    {"path": ["ports", "check"], "values": ["--role", "--http-port", "--https-port"]},
    {"path": ["health", "wait"], "values": ["--timeout", "--role"], "switches": ["--deep"]},
    {"path": ["version"]},
    {"path": ["version", "show"]},
    {"path": ["version", "switch"], "positional": 1},
    {"path": ["version", "confirm"]},
    {"path": ["version", "rollback"]},
    {"path": ["version", "slot"], "positional": 1},
    {"path": ["version", "slot-confirm"]},
    {"path": ["version", "slot-rollback"]},
    {"path": ["update", "check"]},
