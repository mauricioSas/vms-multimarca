    {"path": ["update", "unlock"], "values": ["--owner"], "required": ["--owner"]},
    {"path": ["tls", "setup"], "values": ["--hostname", "--ip", "--python"], "switches": ["--import-root"], "required": ["--hostname"]},
    {"path": ["kiosk", "rotate"]},
    {"path": ["diag", "bundle"], "values": ["--out"], "required": ["--out"]},
    {"path": ["migrate-from-v1"], "values": ["--role", "--profiles", "--python", "--recordings-dir"], "switches": ["--dry-run", "--remove-v1-files", "--no-engine-config", "--no-acl"]},
    {"path": ["help"]},
    {"path": []}
  ]
